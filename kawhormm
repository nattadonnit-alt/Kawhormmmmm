        let currentRotation = 0;
        function drawSpinnerWheel() {
            const canvas = document.getElementById('spinner-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const numItems = SPINNER_ITEMS.length;
            const arc = (2 * Math.PI) / numItems;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            for (let i = 0; i < numItems; i++) {
                const angle = i * arc;
                ctx.beginPath();
                ctx.fillStyle = SPINNER_COLORS[i % SPINNER_COLORS.length];
                ctx.moveTo(100, 100);
                ctx.arc(100, 100, 100, angle, angle + arc);
                ctx.lineTo(100, 100);
                ctx.fill();

                ctx.save();
                ctx.fillStyle = '#5A4A4E';
                ctx.font = '11px Prompt';
                ctx.translate(100 + Math.cos(angle + arc / 2) * 65, 100 + Math.sin(angle + arc / 2) * 65);
                ctx.rotate(angle + arc / 2 + Math.PI / 2);
                ctx.fillText(SPINNER_ITEMS[i], -ctx.measureText(SPINNER_ITEMS[i]).width / 2, 0);
                ctx.restore();
            }
        }

        function spinWheel() {
            const canvas = document.getElementById('spinner-canvas');
            const resultDisplay = document.getElementById('spinner-result');
            const btn = document.getElementById('spin-btn');

            btn.disabled = true;
            resultDisplay.innerText = "à¸à¸³à¸¥à¸±à¸à¸ªà¸¸à¹à¸¡...";

            const numItems = SPINNER_ITEMS.length;
            const randomIndex = Math.floor(Math.random() * numItems);
            const degreesPerItem = 360 / numItems;
            
            const extraDegrees = 360 * 4; 
            const targetDegree = extraDegrees + (360 - (randomIndex * degreesPerItem + degreesPerItem / 2));

            currentRotation += targetDegree;
            canvas.style.transform = `rotate(${currentRotation}deg)`;

            setTimeout(() => {
                resultDisplay.innerText = `à¹à¸à¹à¹à¸§à¸¥à¸²: ${SPINNER_ITEMS[randomIndex]} !`;
                btn.disabled = false;
                if (window.confetti) {
                    confetti({ particleCount: 15, spread: 40, origin: { y: 0.8 } });
                }
            }, 4000);
        }

        // Goals List
        function addGoal(e) {
            e.preventDefault();
            const text = document.getElementById('goal-input').value.trim();
            if (text) {
                appState.goals.push({ id: Date.now(), text, completed: false });
                saveToLocalStorage();
                renderGoals();
                e.target.reset();
