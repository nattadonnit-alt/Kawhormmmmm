        async function addPhotosToCurrentAlbum() {
            if (!currentAlbumId) return;
            const album = appState.albums.find(a => a.id === currentAlbumId);
            if (!album) return;

            const fileInput = document.getElementById('photo-file-input');
            const urlInput = document.getElementById('photo-url-input');

            let added = false;

            // Handle URL input
            if (urlInput.value.trim()) {
                album.photos.push(urlInput.value.trim());
                urlInput.value = '';
                added = true;
            }

            // Handle file input
            if (fileInput.files && fileInput.files.length > 0) {
                for (let i = 0; i < fileInput.files.length; i++) {
                    const file = fileInput.files[i];
                    try {
                        const dataUrl = await readFileAsDataURL(file);
                        album.photos.push(dataUrl);
                        added = true;
                    } catch (err) {
                        console.error("Error reading file:", err);
                    }
                }
                fileInput.value = '';
            }

            if (added) {
                saveToLocalStorage();
                renderCurrentAlbumPhotos();
                renderAlbums();
            }
        }

